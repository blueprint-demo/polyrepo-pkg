{
  "name": "@blueprint-demo/polyrepo-shared",
  "version": "0.2.0",
  "description": "Shared TypeScript library of polyrepo-pkg",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
